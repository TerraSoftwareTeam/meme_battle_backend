# ==============================================================================
# Meme Battle Backend — Environment Configuration Example (.env.example)
# Copy this file to .env and fill in the appropriate values for your environment.
# ==============================================================================

# ─── 1. Docker Compose Image & Ports ───────────────────────────────────────────
APP_IMAGE_TAG=sha-initial
APP_EXTERNAL_PORT=8081
POSTGRES_EXTERNAL_PORT=5435
GRAFANA_EXTERNAL_PORT=3000

# ─── 2. PostgreSQL Database ───────────────────────────────────────────────────
POSTGRES_USER=testuser
POSTGRES_PASSWORD=pass
POSTGRES_DB=testdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_MAX_CONNECTIONS=5
DATABASE_MIN_CONNECTIONS=1

# ─── 3. Web Service & Limits ──────────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8081
MAX_FILE_SIZE_MB=35

# ─── 4. CORS & Frontend Origin ────────────────────────────────────────────────
CORS_ALLOWED_ORIGIN=https://meme.skyfly.hackclub.app

# ─── 5. CDN (Hack Club CDN Storage) ───────────────────────────────────────────
HACKCLUB_CDN_BASE_URL=https://cdn.hackclub.com
HACKCLUB_CDN_API_KEY=

# ─── 6. Security & Cryptographic Keys ─────────────────────────────────────────
# Generate 32-byte secret keys using: openssl rand -base64 32
JWT_SECRET_KEY=change-me-in-local-env-jwt-secret-32-bytes
HMAC_SECRET_KEY=change-me-in-local-env-hmac-secret-32
ARGON2_SECRET_KEY=change-me-in-local-env-argon2-secret-32
SECRET_SEED_KEY=change-me-in-local-env-secret-seed-key-32
DEFAULT_ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
ADMIN_USER_IDS=

# ─── 7. Centrifugo Realtime Engine ────────────────────────────────────────────
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=change-me-in-local-env-jwt-secret-32-bytes
CENTRIFUGO_API_KEY=CHANGE_ME_API_KEY
CENTRIFUGO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
CENTRIFUGO_ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_ALLOWED_ORIGIN=https://meme.skyfly.hackclub.app

# ─── 8. Logging & Observability (OpenTelemetry / Grafana) ──────────────────────
# RUST_LOG format: crate1=level1,crate2=level2,...
RUST_LOG=info,sqlx=debug,tower_http=info,axum::rejection=trace,opentelemetry=info,hyper=info,h2=info,reqwest=info,rustls=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ─── 9. Grafana Dashboard Settings ────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me_grafana_password
GF_PUBLIC_DASHBOARDS_ENABLED=true
GF_SECURITY_ALLOW_EMBEDDING=true
